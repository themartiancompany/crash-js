function
  _argv_url_get(
    _key_name) {
  let
    _argv,
    _assignment,
    _assignments,
    _key,
    _key_value,
    _location,
    _msg,
    _url,
    _value;
  if ( typeof(
         _key_name) === 'undefined' ||
       _key_name == "" ||
       _key_name == null ) {
    _msg =
      "Getting all values.";
    _msg_info(
      _msg);
    _key_name =
      "";
  }
  _argv =
    [];
  _location =
    window.location;
  _url =
    _location.search.substring(
      1);
  _assignments =
    _url.split(
      '&');
  for ( let
          _result =
            0;
        _result <
          _assignments.length;
        _result++ ) {
    _assignment =
      _assignments[
        _result];
    _key_value =
      _assignment.split(
        '=');
    _key =
      _key_value[
        0];
    if ( _key == _key_name ||
         _key_name == "" ) {
      _value =
        _key_value[
          1];
      _argv.push(
        _value);
    }
  }
  return _argv;
}

function
  _argv_get(
    _args) {
  let
    _argv;
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    _argv =
      _yargv_get(
        _args);
  }
  else {
    _argv =
      _argv_url_get();
  }
  return _argv;
}

function
  _yargv_get(
    _args) {
  let
    _boolean;
  const
    _yargs_opts =
      {};
  const
    _parser_opts =
      {};
  if ( typeof(
          _args) == "undefined" ||
       _args == {} ||
       _args == "" ) {
    _args = {
      "booleans": [],
      "string": true
    };
  }
  const
    _booleans =
      _args[
        "booleans"];
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) ) {
    const
      _yargs =
        require(
          "yargs");
    _yargs_helpers_module =
      require(
        "yargs/helpers");
    const
      _hide_bin =
        _yargs_helpers_module.hideBin;
    if ( "string" in _args &&
         _args[
           "string"] ) {
      _yargs_opts[
        "_"] = {
        "type":
          "string",
        "string":
          true
      };
      _parser_opts[
        "parse-numbers"] =
        false;
      _parser_opts[
        "parse-positional-numbers"] =
        false;
    }
    if ( _booleans.length > 0 ) {
      for ( _boolean of _booleans) {
        _yargs_opts[
          _boolean] = {
            "demand":
              false,
            "default":
              false,
            "type":
              "boolean",
         };
      }
    }
    if ( 0 < _booleans.length ||
         _args[
           "string"] ) {
      return _yargs(
               _hide_bin(
                 process.argv)).parserConfiguration(
                   _parser_opts).options(
                _yargs_opts).string(
                  "_").parse();
    }
    else {
      return _yargs(
        _hide_bin(
          process.argv));
    }
  }
}

function
  _global_get() {
  let
    _global;
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    _global =
      global;
  }
  if ( typeof(
         window) != "undefined" ) {
    _global =
      window;
  }
  return _global;
}

function
  _os_tmpdir_get() {
  let
    _os_tmpdir;
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    const
      _os =
        require(
          "os");
    _os_tmpdir =
      _os.tmpdir;
  }
  else {
    _os_tmpdir =
      function
        () {
        return "/tmp";
     };
  }
  return _os_tmpdir;
}

function
  _child_process_spawn_get(
    _spawn_type) {
  let
    _child_process_spawn;
  if ( typeof(
         _spawn_type) == "undefined" ||
       _spawn_type == "" ) {
    _spawn_type =
      "sync";
  }
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    const
      _child_process_module =
        require(
          "node:child_process");
    if ( _spawn_type == "sync" ) {
      _child_process_spawn =
        _child_process_module.spawnSync;
    }
    else if ( _spawn_type == "async" ) {
      _child_process_spawn =
        _child_process_module.spawn;
    }
  }
  else {
    _child_process_spawn =
      function
        (_cmd, _args, _exit) {
        return _exit;
     };
  }
  return _child_process_spawn;
}

async function
  _require(
    _module_name) {
  let
    _exception,
    _found,
    _module,
    _module_file,
    _msg,
    _not_found;
  _found =
    false;
  _not_found =
    false;
  try {
    _module =
      await import(
        _module_name);
    _found =
      true;
  }
  catch(
    _error) {
    if ( _error.code == "MODULE_NOT_FOUND" ) {
      _msg =
        `Program '${_module_name}' ` +
        `not found as module.`;
      _msg_info(
        _msg);
      _not_found =
        true;
    }
    else {
      _display_error(
        _error);
      _exception =
        _error;
    }
  }
  if ( _not_found ) {
    const
      _lib =
        await _lib_get();
    const
      _program_dirs = [
        `${_lib}/${_module_name}`,
        `${_lib}/${_module_name}/nodejs`,
      ];
    for ( _dir of _program_dirs ) {
      _module_file =
        `${_dir}/package.json`;
      if ( _file_exists(
             _module_file) ) {
        _module =
          await import(
            _module_file);
        _found =
          true;
        break;
      }
    }
  }
  if ( ! _found ) {
    _exception[
      "shortMessage"] =
      `Module '${_module_name}'` +
      `found not as Node.js module ` +
      `nor as standalone library module in ` +
      `${_program_dirs}.`;
    throw _exception;
  }
  if ( "default" in _module ) {
    _module =
      _module[
        "default"];
  }
  return _module;
}

module.exports = {
  _argv_get:
    _argv_get,
  _argv_url_get:
    _argv_url_get,
  _child_process_spawn_get:
    _child_process_spawn_get,
  _global_get:
    _global_get,
  _os_tmpdir_get:
    _os_tmpdir_get,
  _require:
    _require,
  _yargv_get:
    _yargv_get
};
