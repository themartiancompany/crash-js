async function
  _require(
    _module_name) {
  let
    _exception,
    _found,
    _module,
    _module_file,
    _msg,
    _not_found;
  _found =
    false;
  _not_found =
    false;
  try {
    _module =
      await import(
        _module_name);
    _found =
      true;
  }
  catch(
    _error) {
    if ( _error.code == "MODULE_NOT_FOUND" ) {
      _msg =
        `Program '${_module_name}' ` +
        `not found as module.`;
      _msg_info(
        _msg);
      _not_found =
        true;
    }
    else {
      _error_display(
        _error);
      _exception =
        _error;
    }
  }
  if ( _not_found ) {
    const
      _lib =
        await _lib_get();
    const
      _program_dirs = [
        `${_lib}/${_module_name}`,
        `${_lib}/${_module_name}/nodejs`,
      ];
    const
      _oldpwd =
        _pwd();
    for ( _dir of _program_dirs ) {
      _module_file =
        `${_dir}/package.json`;
      if ( _file_exists(
             _module_file) ) {
        _cd(
          _lib);
        _module =
          await import(
            _module_name);
        _cd(
          _oldpwd);
        _found =
          true;
        break;
      }
    }
  }
  if ( ! _found ) {
    _msg =
      `Module '${_module_name}'` +
      `found not as Node.js module ` +
      `nor as standalone library module in ` +
      `${_program_dirs}.`;
    _msg_error(
      _msg,
      0);
    _exception[
      "shortMessage"] =
      _msg;
    throw _exception;
  }
  if ( "default" in _module ) {
    _module =
      _module[
        "default"];
  }
  return _module;
}

