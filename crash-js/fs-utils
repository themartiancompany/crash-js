function
  _ext_rm(
    _path) {
  let
    _dir,
    _name,
    _paths;
  _dir =
    _path_module_parse(
      _path).dir;
  _name =
    _path_module_parse(
      _path).name;
  _paths = [
    _dir,
    _name];
  return _path_join(
    _paths); 
}

function
  _file_exists(
    _path) {
  let
    _exists,
    _return;
  _return =
    false;
  _exists =
    _fs_exists_sync(
      _path);
  if (_exists) {
    _return =
      true;
  }
  return _return;
}

function
  _file_read(
    _path,
    _read_opts) {
  const
    _read_opts_type =
      typeof(
        _read_opts);
  if ( _read_opts_type === "undefined" ||
       _read_opts == {} ||
       _read_opts == "" ) {
    _read_opts =
      {"encoding":
         "utf8",
       "flag":
         'r'};
  }
  const
    _return =
      _fs_read_file_sync(
        _path,
        _read_opts);
  return _return;
}

const
  _cat =
    _file_read;

function
  _file_append(
    _path,
    _content,
    _options) {
  const
    _fs_append_file_sync_args = [
      _path,
      _content
    ];
  if ( typeof(
         _options) != "undefined" &&
       _options != {} &&
       _options != "" ) {
    _fs_append_file_sync_args.push(
      _options);
  }
  _fs_append_file_sync.apply(
    null,
    _fs_append_file_sync_args);
}

function
  _file_write(
    _path,
    _content,
    _append) {
  _fs_write_file_sync(
    _path,
    _content);
}

function
  _json_read(
    _json_path) {
  let
    _json_str,
    _json;
  _json_str =
    _file_read(
      _json_path);
  _json =
    _json_parse(
      _json_str);
  return _json;
}

async function
  _lib_get() {
  let
    _lib,
    _lib_path,
    _line,
    _out,
    _path,
    _words;
  const
    _paths =
      new Set();
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    const
      _out =
        await _run(
         "sync",
          [ "ldconfig",
            "-p" ]);
    // console.log(_out);
    const
      _tail =
        _out.slice(
          1,
          _out.length - 2);
    for ( _line of _tail ) {
      _words =
        _line.split(" ");
      _lib_path =
        _words[
          3];
      _lib =
        _dirname(
          _lib_path);
      _paths.add(
        _lib);
    }
    if ( typeof(
           process.env.NODE_PATH) == "undefined" ||
         process.env.NODE_PATH == "" ) {
      const
        _msg =
          "Environment variable NODE_PATH undefined.";
      _msg_info(
        _msg);
    }
    else {
      _lib =
        _path_join(
          [ process.env.NODE_PATH,
            "../lib" ]);
      if ( _file_exists(
             _lib) ) {
        _paths.add(
          _lib);
      }
    }
    for ( _path of _paths ) {
      return _path;
    }
  }
  else {
    _lib =
      "/usr/lib";
  }
  return _lib
}

function
  _ls(
    _args) {
  const
    _return =
      _fs_read_dir_sync.apply(
        null,
        [_args]);
  return _return;
} 

async function
  _os_tmpdir_get() {
  let
    _os_tmpdir;
  if ( typeof window === 'undefined' &&
       ( typeof global !== 'undefined' && global.global === global ) &&
       typeof __webpack_require__ !== 'function' ) {
    const
      _os =
        await import(
          "os");
    _os_tmpdir =
      _os.tmpdir;
  }
  else {
    _os_tmpdir =
      function
        () {
        return "/tmp";
     };
  }
  return _os_tmpdir;
}

async function
_mktemp(
  _prefix,
  _directory) {
  const
    _directory_type =
      typeof(
        _directory);
  if ( typeof(
         _prefix) == "undefined" ||
       _prefix == "" ) {
    const
      _os_tmpdir =
        await _os_tmpdir_get();
    _prefix =
      `${_os_tmpdir}/tmp.`;
  }
  if ( _directory_type == "undefined" ||
       _directory == "" ||
       _directory == "true" ) {
    _directory =
      true;
  }
  if ( _directory == "false" ) {
    _directory =
      false;
  }
  if ( _directory ) {
    try {
      const
        _dir =
          _mkdtemp(
            _prefix);
      return _dir;
    }
    catch(
      _error) {
      throw _error;
    }
  }
  else {
    _msg =
      "It only supports creating " +
      "temporary directories.";
    console.error(
      _msg);
    _exit(
      1);
  }
}

function
  _path_join(
    _paths) {
  let
    _path;
  _path =
    _path_module_join.apply(
      null,
      _paths);
  return _path;
}

async function
  _printf(
    _text,
    _array) {
  let
    _text_display;
  _text_display =
    _text;
  const
    _array_type =
      typeof(
        _array);
  if ( _array_type == "undefined" ) {
    _array =
      [];
  }
  for ( _item of _array ) {
    _text_display =
      _text_display.replace(
        "%s",
        _item);
  }
  _stdout.write(
    _text_display);
}

