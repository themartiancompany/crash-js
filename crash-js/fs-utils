      _file_path);
  return _dir;
}

function
  _dir_exists(
    _dir) {
  try {
    _return =
      _is_dir(
        _dir);
  }
  catch(
    _error) {
    const
      _code =
        _error[
          "code"];
    if ( _code == "ENOENT" ) {
      _return =
        false
    }
    else {
      throw _error;
    }
  }
  return _return;
}

function
  _dirname(
