async function
  _cmdline_check(
    _app_name) {
  let
    _argv,
    _program,
    _program_name;
  if ( typeof window === 'undefined' ) {
    _argv =
      await _argv_get();
    _program =
      _argv[
        1];
    if ( typeof(
           _program) === 'undefined' ) {
      _program =
        _argv[
          "$0"];
    }
    _program_name =
      _basename(
        _program);
    if ( _program_name == _app_name ) {
      return true;
    }
    else {
      return false;
    }
  }
  else {
    return false;
  }
}

